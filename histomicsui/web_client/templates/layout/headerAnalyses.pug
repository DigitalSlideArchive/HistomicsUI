mixin analysisItem(task, source)
  li
    a.h-analysis-item(
        tabindex='0',
        href='#',
        title=source ? `${task.cli} (${source})` : task.cli,
        data-api=task.api,
        data-image=task.image,
        data-version=task.version,
        data-cli=task.cli,
        data-search=task.search) #{task.cli}
      if source
        span.h-analyses-item-source #{source}

a.h-analyses-dropdown-link(data-toggle='dropdown')
  | #[span.icon-tasks] Analyses #[span.icon-down-open]
.h-analyses-dropdown.dropdown-menu(role='menu')
  input.h-analyses-filter.form-control.input-sm(
      type='text', placeholder='Search analyses', aria-label='Search analyses', autocomplete='off')
  .h-analyses-columns
    ul.h-analyses-images
      if recent.length
        li.h-analyses-image.h-analyses-recent(data-key=recentKey)
          a(tabindex='0', href='#') Recently used
      each image in images
        li.h-analyses-image(data-key=image.name)
          a(tabindex='0', href='#', title=image.name, data-name=image.name) #{image.label}
    .h-analyses-tasks
      if recent.length
        .h-analyses-task-group(data-key=recentKey)
          ul
            each task in recent
              +analysisItem(task, `${task.label}:${task.version}`)
      each image in images
        .h-analyses-task-group(data-key=image.name)
          each version in image.versions
            .h-analyses-version
              .h-analyses-version-name(title=version.name) #{version.name}
              ul
                each task in version.tasks
                  +analysisItem(task)
      .h-analyses-empty.hidden No matching analyses
