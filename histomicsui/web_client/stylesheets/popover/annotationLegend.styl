.h-annotation-legend-container
  position absolute
  // Sit to the right of the left panel group.  When nothing is shown in that
  // group, move to the far left; browsers without :has() keep this default.
  left 305px
  bottom 5px
  max-width 300px
  max-height calc(100% - 10px)
  overflow-y auto
  overflow-x hidden
  background-color rgba(255, 255, 255, 0.85)
  border 1px solid #000
  border-radius 3px
  padding 2px 6px 4px
  z-index 980
  font-size 12px
  user-select none

  .h-annotation-legend-header
    font-weight bold
    cursor pointer
    white-space nowrap

    .h-annotation-legend-toggle
      margin-left 8px

  .h-annotation-legend-name
    font-weight bold
    margin-top 3px
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

  .h-annotation-legend-entry
    display flex
    align-items center
    margin 2px 0

    .h-annotation-legend-swatch
      display inline-block
      width 18px
      height 18px
      margin-right 5px
      flex-shrink 0
      box-sizing border-box
      border 0 solid transparent
      background transparent

    .h-annotation-legend-label
      overflow hidden
      text-overflow ellipsis
      white-space nowrap

  .h-annotation-legend-range
    display block
    min-width 200px

    .h-annotation-legend-bar
      width 100%
      height 12px
      margin-top 1px
      box-sizing border-box
      border 0 solid transparent

    .h-annotation-legend-range-labels
      position relative
      height 1.3em
      white-space nowrap

      .h-annotation-legend-range-label
        position absolute
        top 0

.h-image-body:not(:has(.h-panel-group-left > :not(.hidden))) .h-annotation-legend-container
  left 5px
