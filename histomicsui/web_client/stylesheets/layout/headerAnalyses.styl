.h-analyses-dropdown.dropdown-menu
  padding 6px 0 0
  // wide enough for the longest names; the view then fixes this width
  width max-content
  max-width calc(100vw - 20px)

  .h-analyses-filter
    margin 0 6px 6px
    width calc(100% - 12px)

  // The images are under the menu button and the tasks open to the left of
  // them, as the menu is at the right of the window.
  .h-analyses-columns
    display flex
    flex-direction row-reverse
    border-top 1px solid #e5e5e5

  .h-analyses-images, .h-analyses-tasks
    max-height calc(100vh - 120px)
    min-height 130px
    min-width 0
    overflow-x hidden
    overflow-y auto
    scrollbar-gutter stable
    margin 0
    padding 4px 0

  .h-analyses-images
    flex 0 1 auto
    list-style none
    border-left 1px solid #e5e5e5

  .h-analyses-tasks
    flex 1 1 auto

    ul
      list-style none
      margin 0
      padding 0

  // names are never truncated; they only wrap if the window is too narrow
  li > a
    display block
    padding 3px 16px
    color #333
    overflow-wrap anywhere

    &:hover, &:focus
      text-decoration none
      background-color #f5f5f5

  .h-analyses-image > a
    position relative
    padding-left 24px

  // the selected image is marked with an arrow as well as shading
  .h-analyses-image.h-active > a
    background-color #e8e8e8

    &:after
      content "\25C2"
      position absolute
      left 8px

  .h-analyses-recent
    border-bottom 1px solid #e5e5e5
    font-style italic

  // unselected groups still take up width so the menu fits the longest name
  .h-analyses-task-group
    height 0
    overflow hidden
    visibility hidden

    &.h-active
      height auto
      overflow visible
      visibility visible

  .h-analyses-version + .h-analyses-version
    border-top 1px solid #e5e5e5
    margin-top 4px
    padding-top 4px

  .h-analyses-version-name
    padding 3px 12px
    font-size 13px
    font-weight bold
    color #666
    overflow-wrap anywhere

  .h-analyses-item-source
    display block
    font-size 11px
    color #666

  .h-analyses-empty
    padding 3px 16px
    color #666
